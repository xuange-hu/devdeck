{
  "name": "devdeck-cli",
  "version": "0.7.0",
  "description": "开发端口监管控制台：实时监控、一键释放被占用端口（CLI + Web UI）",
  "type": "module",
  "bin": {
    "devdeck": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "dist/web"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/copy-web.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "scan": "node dist/cli.js scan",
    "ui": "node dist/cli.js ui",
    "test": "node --import tsx --test test/unit.test.ts test/e2e.test.ts",
    "build:exe": "node scripts/build-exe.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "port",
    "ports",
    "devtool",
    "cli",
    "network",
    "process",
    "kill-port",
    "web-ui",
    "monitor"
  ],
  "author": "DevDeck",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
